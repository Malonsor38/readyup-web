# Clean URLs — /faq serves faq.html, and so on.
# Works on Cloudflare Pages and Netlify (same file format).
# 200 = rewrite (address bar keeps the pretty URL). 301 = real redirect.

/faq            /faq.html           200
/guidelines     /guidelines.html    200
/join           /join.html          200
/edit           /edit.html          200
/profile        /profile.html       200

# Common guesses, so nobody lands on a 404
/signup         /join               301
/sign-up        /join               301
/register       /join               301
/login          /join               301
/signin         /join               301
/sign-in        /join               301
/account        /edit               301
/settings       /edit               301
/my-profile     /edit               301
/rules          /guidelines         301
/code-of-conduct /guidelines        301
/help           /faq                301
/questions      /faq                301

