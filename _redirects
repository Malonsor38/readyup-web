# Routing. ORDER MATTERS — first match wins.
#
# html_handling is OFF in wrangler.jsonc, so nothing is auto-redirected behind
# our backs. That matters: with it on, Cloudflare turned the /p/* rewrite into
# an external redirect to /project and threw the ?slug= away.
#
# There is NO catch-all in this file. A /* rule is evaluated before static
# files and swallows CSS, JS and images. Member profiles are served instead by
# 404.html (a copy of profile.html), which Cloudflare returns for any path that
# isn't a real file — see not_found_handling in wrangler.jsonc.
#
# 200 = rewrite, the address bar keeps the pretty URL.
# 301 = a real redirect.

# --- real pages, each declared explicitly
/                /index.html                 200
/faq             /faq.html                   200
/guidelines      /guidelines.html            200
/join            /join.html                  200
/edit            /edit.html                  200
/profile         /profile.html               200

# --- project spaces: /p/<slug> keeps its pretty URL, project.html reads ?slug
/p/*             /project.html?slug=:splat   200

# --- convenience redirects
/signup          /join         301
/sign-up         /join         301
/register        /join         301
/login           /join         301
/signin          /join         301
/sign-in         /join         301
/account         /edit         301
/settings        /edit         301
/my-profile      /edit         301
/rules           /guidelines   301
/code-of-conduct /guidelines   301
/help            /faq          301
/questions       /faq          301
/projects        /edit         301
