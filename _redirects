# Convenience redirects only.
#
# NO catch-all here. On Cloudflare Workers this file is evaluated before static
# files are matched, so a /* rule swallows CSS, JS and images too and the site
# loads unstyled. Member profiles are handled instead by 404.html, which
# Cloudflare serves for any path that isn't a real file — see wrangler.jsonc.
#
# Clean URLs (/faq -> faq.html) come from html_handling, not from rules here.
# Do not add page rewrites: combined with html_handling they cause a loop.

# Project spaces: /p/<slug> is served by project.html, which reads the slug.
# Specific, not a catch-all, so it can't swallow assets.
/p/*             /project.html?slug=:splat   200

/signup          /join         301
/sign-up         /join         301
/register        /join         301
/login           /join         301
/signin          /join         301
/sign-in         /join         301
/account         /edit         301
/settings        /edit         301
/my-profile      /edit         301
/rules           /guidelines   301
/code-of-conduct /guidelines   301
/help            /faq          301
/questions       /faq          301
